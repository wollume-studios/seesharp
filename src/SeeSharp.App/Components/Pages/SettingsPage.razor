@page "/settings"
@inject CourseState State

<PageTitle>@Strings.SettingsTitle</PageTitle>
<h1>@Strings.SettingsTitle</h1>

@if (State.Course is null)
{
    <p class="bad">@(State.CoursePath is null ? Strings.NoCourseFound : string.Format(Strings.CourseNotFoundAt, State.CoursePath))</p>
}
else
{
    <p class="ok">@string.Format(Strings.CourseLoadedFrom, State.CoursePath)</p>
    <p>@(State.BookPdfPath is { } pdf ? string.Format(Strings.BookFound, pdf) : Strings.BookMissing)</p>
}

<p><label>@Strings.CoursePathLabel<br /><input type="text" @bind="_course" /></label></p>
<p><label>@Strings.BookPdfLabel<br /><input type="text" @bind="_book" /></label></p>
<p class="hint">@string.Format(Strings.SettingsFileHint, Settings.DefaultPath)</p>
<button @onclick="Save">@Strings.Save</button>
<button @onclick="State.LoadAsync">@Strings.Reload</button>

<h2>@Strings.IdesTitle</h2>
@* User request 2026-11-19: detection misses some installs (e.g. a Rider outside Toolbox's usual folders), so each path can be typed in. *@
<p class="hint">@Strings.IdePathHint</p>
@foreach (var ide in Enum.GetValues<IdeKind>())
{
    <p>
        <label>@Strings.ForIde(ide)<br /><input type="text" @bind="_ides[ide]" placeholder="@Strings.IdeNotFound" /></label>
        @if (!string.IsNullOrWhiteSpace(_ides[ide]) && State.Ides.GetValueOrDefault(ide) != _ides[ide].Trim())
        {
            <br /><span class="bad">@Strings.IdePathMissing</span>
        }
    </p>
}
<button @onclick="SaveIdes">@Strings.IdePathsSave</button>
<button @onclick="Redetect">@Strings.RedetectIdes</button>

<TutorSettings />

@code {
    private string _course = "";
    private string _book = "";
    private readonly Dictionary<IdeKind, string> _ides = new();

    protected override void OnInitialized()
    {
        _course = State.Settings.CoursePath ?? State.CoursePath ?? "";
        _book = State.Settings.BookPdfPath ?? "";
        ShowIdes();
    }

    private void ShowIdes()
    {
        foreach (var ide in Enum.GetValues<IdeKind>())
            _ides[ide] = State.Ides.GetValueOrDefault(ide) ?? "";
    }

    /// <summary>A typed path wins while the file exists (IdeResolver.Resolve); a missing one falls back to detection, and the page says so.</summary>
    private void SaveIdes()
    {
        var settings = Settings.Load();
        string? Path(IdeKind ide) => string.IsNullOrWhiteSpace(_ides[ide]) ? null : _ides[ide].Trim().Trim('"');
        settings.RiderPath = Path(IdeKind.Rider);
        settings.VsCodePath = Path(IdeKind.VsCode);
        settings.VisualStudioPath = Path(IdeKind.VisualStudio);
        settings.Save();
        State.DetectIdes();
        foreach (var ide in Enum.GetValues<IdeKind>())
            _ides[ide] = Path(ide) ?? State.Ides.GetValueOrDefault(ide) ?? ""; // keep what was typed, so a wrong path stays visible with its note
    }

    private async Task Save()
    {
        var settings = Settings.Load();
        settings.CoursePath = string.IsNullOrWhiteSpace(_course) ? null : _course.Trim();
        settings.BookPdfPath = string.IsNullOrWhiteSpace(_book) ? null : _book.Trim();
        settings.Save();
        await State.LoadAsync();
    }

    // vswhere is a child process; keep the circuit responsive while it runs.
    private async Task Redetect()
    {
        await Task.Run(() => State.DetectIdes(force: true));
        ShowIdes();
    }
}
